{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PRINTER_PROFILE",
  "description": "Repo-root printer defaults consumed by the planning phase before BUILD_PLAN.json is generated",
  "type": "object",
  "required": ["printer", "material", "nozzle_mm", "constraints"],
  "additionalProperties": false,
  "properties": {
    "design_intent": {
      "type": "string",
      "enum": ["print", "cad"],
      "description": "\"print\" (default when absent): design for FDM. \"cad\": nominal geometry, no print clearances, wall minimums, overhang fixes or print-pose rotation."
    },
    "motion": {
      "type": "object",
      "description": "Machine motion + slicer profile constants consumed by the toolpath-speed-advisor capability. Optional -- absent means the advisor is skipped, never defaulted.",
      "required": [
        "v_cruise_mm_s",
        "accel_mm_s2",
        "junction_deviation_mm",
        "min_layer_time_s",
        "layer_height_mm",
        "line_width_mm",
        "infill_density"
      ],
      "additionalProperties": false,
      "properties": {
        "v_cruise_mm_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Steady-state perimeter print speed in mm/s"
        },
        "accel_mm_s2": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Print acceleration in mm/s^2"
        },
        "junction_deviation_mm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Firmware junction-deviation constant (mm) used to derive cornering speed at sharp corners"
        },
        "min_layer_time_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Slicer's minimum time per layer; a shorter estimated layer path stalls at this floor"
        },
        "layer_height_mm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Slicer layer height in mm"
        },
        "line_width_mm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Slicer extrusion line width in mm"
        },
        "infill_density": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fractional infill density (0-1) used to estimate per-layer infill path length"
        }
      }
    },
    "slicer": {
      "type": "object",
      "description": "Slicer the deliverables are made for. Optional in the schema; build.py requires slicer.preferred_format.",
      "required": ["preferred_format"],
      "additionalProperties": false,
      "properties": {
        "preferred_format": {
          "type": "string",
          "enum": ["3mf", "stl", "step", "obj", "iges", "scad"],
          "description": "Format build.py always writes per union, in addition to model.3mf and the STLs"
        },
        "slicer_name": {
          "type": "string",
          "minLength": 1,
          "description": "Slicer name, e.g. 'OrcaSlicer'. Informational only."
        },
        "estampo": {
          "type": "object",
          "description": "Orca profile names written into estampo.toml by build.py --formats estampo. Omitted names become commented placeholders.",
          "additionalProperties": false,
          "properties": {
            "printer": {"type": "string", "minLength": 1},
            "process": {"type": "string", "minLength": 1},
            "filaments": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
          }
        }
      }
    },
    "orca": {
      "type": "object",
      "description": "Orca-family slicer presets this profile was imported from (orca_profile.py). The plain fields hold the resolved snapshot; digest detects drift.",
      "required": ["app", "data_dir", "machine", "process", "process_purpose", "filaments", "processes", "digest"],
      "additionalProperties": false,
      "properties": {
        "app": {"type": "string", "enum": ["OrcaSlicer", "Snapmaker_Orca", "BambuStudio"]},
        "data_dir": {"type": "string", "minLength": 1},
        "machine": {"type": "string", "minLength": 1},
        "process": {"type": "string", "minLength": 1},
        "process_purpose": {"type": "string", "enum": ["visual", "functional", "draft", "user"]},
        "filaments": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "processes": {
          "type": "array",
          "minItems": 1,
          "description": "Every process preset compatible with the machine, for the planner to choose from",
          "items": {
            "type": "object",
            "required": ["name", "layer_height_mm", "wall_loops", "infill_density", "user"],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "layer_height_mm": {"type": "number", "exclusiveMinimum": 0},
              "wall_loops": {"type": "integer", "minimum": 0},
              "infill_density": {"type": "number", "minimum": 0, "maximum": 1},
              "user": {"type": "boolean"}
            }
          }
        },
        "digest": {"type": "string", "minLength": 1}
      }
    },
    "build_volume_mm": {
      "type": "object",
      "description": "Printable volume in build-plate axes",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": {"type": "number", "exclusiveMinimum": 0},
        "y": {"type": "number", "exclusiveMinimum": 0},
        "z": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "fit_clearance_mm": {
      "type": "object",
      "description": "Mating-face clearance per fit type for this printer/material. Optional; absent means the planning prompt's built-in table (press 0.0, snap 0.15, sliding 0.25, loose 0.5).",
      "additionalProperties": false,
      "properties": {
        "press_fit": {"type": "number", "minimum": 0},
        "snap_fit": {"type": "number", "minimum": 0},
        "sliding": {"type": "number", "minimum": 0},
        "loose": {"type": "number", "minimum": 0}
      }
    },
    "printer": {
      "type": "string",
      "description": "Printer model, e.g. 'Bambu P1S', 'Prusa MK4', 'Ender 3'"
    },
    "material": {
      "type": "string",
      "enum": ["PLA", "PETG", "ABS", "ASA", "TPU", "PA", "PC"],
      "description": "Default filament material"
    },
    "nozzle_mm": {
      "type": "number",
      "enum": [0.2, 0.4, 0.6, 0.8],
      "description": "Default nozzle diameter in mm"
    },
    "max_materials": {
      "type": "integer",
      "minimum": 1,
      "description": "Configured filament slots (distinct material+color pairs one print can use). Absent means 1."
    },
    "constraints": {
      "type": "object",
      "required": ["wall_min_mm", "overhang_max_deg", "dimension_tolerance_mm"],
      "additionalProperties": true,
      "properties": {
        "wall_min_mm": {
          "type": "number",
          "minimum": 0.4,
          "description": "Minimum wall thickness for DFM check"
        },
        "interface_min_area_mm2": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Minimum area of the join between a placed block and the body it is unioned onto; absent means 4.0"
        },
        "overhang_max_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 90,
          "description": "Maximum overhang angle before support required"
        },
        "bridge_max_mm": {
          "type": "number",
          "minimum": 0,
          "description": "Longest span (mm), supported on two or more sides, printed as a bridge without support (default 10)"
        },
        "dimension_tolerance_mm": {
          "type": "number",
          "minimum": 0,
          "description": "Tolerance for dimension mismatch check"
        },
        "top_bottom_layers": {
          "type": "integer",
          "minimum": 1,
          "description": "Top/bottom solid shell layer count (default 4 when absent)"
        }
      }
    }
  }
}
