  "hooks": {
    "_comment": "Seeded into the working directory's .claude/settings.local.json by init_permissions.py, which substitutes {session_cost_path} with the absolute path to src/session_cost.py and {log_path} with the absolute path to src/log.py at seed time. The Stop hook records billed token cost into build/cost.json after every turn; it is a no-op when build/ is absent and always exits 0. The PostToolUse hook records the base per-attempt telemetry record into build/attempts.jsonl after every run_cadquery_model.py call; it is a no-op on any non-matching command, missing build/, or unparseable result, and always exits 0.",
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"{session_cost_path}\" --hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"{log_path}\" --hook"
          }
        ]
      }
    ]
  }
}
