{
  "_comment": "Canonical Claude Code permission allow-patterns the cq-design pipeline needs. Seeded into the working directory's .claude/settings.local.json by init_permissions.py. The run_cadquery_model.py Bash entry is the sentinel used to detect prior init. Both Bash and PowerShell variants are included; wildcards absorb the interpolated SKILL_DIR path and per-part arguments. Read/scaffold/build shapes only -- no destructive verbs.",
  "sentinel": "Bash(uv run --project * python * run_cadquery_model.py *)",
  "allow": [
    "Bash(uv run --project * python * run_cadquery_model.py *)",
    "Bash(uv run --project * python * print_orientation.py *)",
    "Bash(uv run --project * python * model_export.py *)",
    "Bash(uv run --project * python * quality_gate.py *)",
    "Bash(uv run --project * python * regen_prompt.py *)",
    "Bash(uv run --project * python * render_prompt.py *)",
    "Bash(uv run --project * python * telemetry.py *)",
    "Bash(uv run --project * python * plan_validate.py *)",
    "Bash(uv run --project * python * printer_profile_validate.py *)",
    "Bash(uv run --project * python * import_params.py *)",
    "Bash(uv run --project * python * measure_stl.py *)",
    "Bash(python * plan_validate.py *)",
    "Bash(python * measure_stl.py *)",
    "Bash(python * blocks/validate.py *)",
    "Bash(python * init_permissions.py *)",
    "Bash(python * printer_profile_validate.py *)",
    "Bash(python * convert_build123d.py *)",
    "Bash(python * request_log_search.py *)",
    "Bash(python * import_params.py *)",
    "Bash(uv sync*)",
    "Bash(uv run python build/build.py*)",
    "Bash(cp *)",
    "Bash(mkdir *)",
    "PowerShell(uv run --project * python * run_cadquery_model.py *)",
    "PowerShell(uv run --project * python * print_orientation.py *)",
    "PowerShell(uv run --project * python * model_export.py *)",
    "PowerShell(uv run --project * python * quality_gate.py *)",
    "PowerShell(uv run --project * python * regen_prompt.py *)",
    "PowerShell(uv run --project * python * render_prompt.py *)",
    "PowerShell(uv run --project * python * telemetry.py *)",
    "PowerShell(uv run --project * python * plan_validate.py *)",
    "PowerShell(uv run --project * python * printer_profile_validate.py *)",
    "PowerShell(uv run --project * python * import_params.py *)",
    "PowerShell(uv run --project * python * measure_stl.py *)",
    "PowerShell(python * plan_validate.py *)",
    "PowerShell(python * measure_stl.py *)",
